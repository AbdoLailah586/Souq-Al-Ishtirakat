@echo off
chcp 65001 > nul
title موقع سوق الاشتراكات الرقمية - تشغيل السيرفر المحلي
echo ========================================================
echo        🏮 تشغيل موقع سوق الاشتراكات الرقمية 🏮
echo ========================================================
echo.

cd /d "%~dp0"

if not exist "node_modules\" (
    echo [1/2] جارٍ تثبيت الحزم والمكتبات لأول مرة... يرجى الانتظار...
    call npm install
    if %errorlevel% neq 0 (
        echo [خطأ] فشل تثبيت الحزم. تأكد من اتصال الإنترنت ثم أعد المحاولة.
        pause
        exit /b %errorlevel%
    )
) else (
    echo [1/2] الحزم مثبتة بالفعل.
)

echo.
echo [2/2] بدء تشغيل سيرفر الموقع المحلي...
echo الموقع سيعمل الآن على الرابط: http://localhost:3000
echo.
echo اضغط Ctrl+C لإيقاف السيرفر في أي وقت.
echo ========================================================

start http://localhost:3000
call npm run dev

pause
